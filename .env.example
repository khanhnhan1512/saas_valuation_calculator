# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string. Set automatically when Neon is connected in the
# Vercel dashboard (Storage tab). Leave empty locally to use the embedded PGlite database.
DATABASE_URL=

# Staff export access: one shared password, and a random secret that signs the session cookie.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STAFF_PASSWORD=
AUTH_SECRET=

# Email through Resend: the visitor gets their result, the team inbox gets every lead.
# Leave empty locally to turn email off. On Vercel all three are required.
# RESEND_API_KEY: Resend dashboard > API Keys (sending access is enough).
# EMAIL_FROM: an address on the domain verified in Resend, e.g. Aspen Valuations <no-reply@aspenval.com>
# EMAIL_TEAM_TO: the shared company inbox; it also receives the visitors' replies.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TEAM_TO=

# Optional: send over SMTP instead of Resend (e.g. a Gmail account for a demo). When SMTP_HOST is
# set it wins over Resend. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail
# address, SMTP_PASS=an app password, and EMAIL_FROM must use that same Gmail address.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
