# Copy to .env.local for local development. Never commit real values.

# Neon Postgres connection string. Set automatically when Neon is connected in the
# Vercel dashboard (Storage tab). Leave empty locally to use the embedded PGlite database.
DATABASE_URL=

# Staff export access: one shared password, and a random secret that signs the session cookie.
# Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STAFF_PASSWORD=
AUTH_SECRET=
